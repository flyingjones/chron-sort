<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <OptimizationPreference>Speed</OptimizationPreference>
        <InvariantGlobalization>true</InvariantGlobalization>
        <Version>0.2.0.0</Version>
        <Authors>Jonas Kett</Authors>
        <RootNamespace>ImageSorter</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.12" />
      <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.12" />
      <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.12" />
      <PackageReference Include="System.CommandLine" Version="2.0.2" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ImageSorter.FileScanning\ImageSorter.FileScanning.csproj" />
      <ProjectReference Include="..\ImageSorter.ResultWriting\ImageSorter.ResultWriting.csproj" />
      <ProjectReference Include="..\ImageSorter.Sorting\ImageSorter.Sorting.csproj" />
      <ProjectReference Include="..\ImageSorter.Utils\ImageSorter.Utils.csproj" />
      <ProjectReference Include="..\ImageSorter.Markdown\ImageSorter.Markdown.csproj" />
      <ProjectReference Include="..\ImageSorter.DateParsing\ImageSorter.DateParsing.csproj" />
    </ItemGroup>

</Project>
